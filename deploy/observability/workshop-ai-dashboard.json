{
  "title": "Workshop AI \u2014 ARO",
  "uid": "workshop-ai-aro",
  "schemaVersion": 22,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "graph",
      "title": "Model tokens by subscription",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (model, subscription) (authorized_hits{model=\"deepseekv4pro\",subscription=~\"deepseekv4pro-(workshop|signal-desk)\"})",
          "refId": "A",
          "legendFormat": "{{model}} {{subscription}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Model requests accepted by quota checks",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (subscription) (authorized_calls{limitador_namespace=\"llm-serving/deepseekv4pro\",subscription=~\"deepseekv4pro-(workshop|signal-desk)\"})",
          "refId": "A",
          "legendFormat": "{{subscription}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 3,
      "type": "graph",
      "title": "Quota rejections (HTTP 429)",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(limited_calls{limitador_namespace=\"llm-serving/deepseekv4pro\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "Quota rejections (HTTP 429)"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 4,
      "type": "graph",
      "title": "D3 completed scoring requests",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(vllm_srun_requests_total{namespace=\"decision-serving\",exported_endpoint=\"/v1/systemone\",status=\"200\"})",
          "refId": "A",
          "legendFormat": "Whisper completed requests"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 5,
      "type": "graph",
      "title": "D3 request latency p95",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm_srun_request_duration_seconds_bucket{namespace=\"decision-serving\",exported_endpoint=\"/v1/systemone\"}[5m])))",
          "refId": "A",
          "legendFormat": "Whisper inference latency p95"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "s",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 6,
      "type": "graph",
      "title": "D3 queued requests",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(vllm_srun_queue_depth{namespace=\"decision-serving\"})",
          "refId": "A",
          "legendFormat": "Whisper queued requests"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 7,
      "type": "graph",
      "title": "T4 utilization \u2014 D3 scoring",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL{exported_namespace=\"decision-serving\"}",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "percent",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 8,
      "type": "graph",
      "title": "T4 memory used (GiB)",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{exported_namespace=\"decision-serving\"} / 1024",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 9,
      "type": "graph",
      "title": "Scrape health \u2014 1 means reachable",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "expr": "min by (namespace) (up{namespace=~\"decision-serving|kuadrant-system\",job=~\"d3-mini|kuadrant-system/kuadrant-limitador-monitor\"})",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    }
  ]
}
