{
  "title": "Workshop AI \u2014 ARO",
  "uid": "workshop-ai-aro",
  "schemaVersion": 22,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "graph",
      "title": "Coding tokens by subscription",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (model, subscription) (authorized_hits{model=\"deepseekv4pro\",subscription=\"deepseekv4pro-workshop\"})",
          "refId": "A",
          "legendFormat": "{{model}} {{subscription}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Coding requests accepted by quota checks",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (subscription) (authorized_calls{limitador_namespace=\"llm-serving/deepseekv4pro\",subscription=\"deepseekv4pro-workshop\"})",
          "refId": "A",
          "legendFormat": "{{subscription}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 3,
      "type": "graph",
      "title": "Quota rejections (HTTP 429)",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(limited_calls{limitador_namespace=\"llm-serving/deepseekv4pro\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "Quota rejections (HTTP 429)"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 4,
      "type": "graph",
      "title": "Whisper completed requests",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(vllm:request_success_total{namespace=\"speech-serving\",finished_reason=\"stop\"})",
          "refId": "A",
          "legendFormat": "Whisper completed requests"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 5,
      "type": "graph",
      "title": "Whisper inference latency p95",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{namespace=\"speech-serving\"}[5m])))",
          "refId": "A",
          "legendFormat": "Whisper inference latency p95"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "s",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 6,
      "type": "graph",
      "title": "Whisper queued requests",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "targets": [
        {
          "expr": "sum(vllm:num_requests_waiting{namespace=\"speech-serving\"})",
          "refId": "A",
          "legendFormat": "Whisper queued requests"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 7,
      "type": "graph",
      "title": "T4 utilization \u2014 speech only",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL{exported_namespace=\"speech-serving\"}",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "percent",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 8,
      "type": "graph",
      "title": "T4 memory used (GiB)",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED{exported_namespace=\"speech-serving\"} / 1024",
          "refId": "A",
          "legendFormat": "{{modelName}} GPU {{gpu}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    },
    {
      "id": 9,
      "type": "graph",
      "title": "Scrape health \u2014 1 means reachable",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "expr": "min by (namespace) (up{namespace=~\"speech-serving|kuadrant-system\",job=~\"whisper-predictor|kuadrant-system/kuadrant-limitador-monitor\"})",
          "refId": "A",
          "legendFormat": "{{namespace}}"
        }
      ],
      "legend": {
        "show": true
      },
      "lines": true,
      "linewidth": 2,
      "yaxes": [
        {
          "format": "short",
          "min": 0,
          "show": true
        },
        {
          "format": "short",
          "show": false
        }
      ],
      "xaxis": {
        "mode": "time",
        "show": true
      }
    }
  ]
}
