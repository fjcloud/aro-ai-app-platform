#!/bin/bash
# Container main process. The tmux server is started here, not from an exec,
# so closing the browser disconnects the client and leaves the session running.
SOCKET=/var/tmux/workshop
SESSION=workshop
mkdir -p /var/tmux
chmod 700 /var/tmux
if ! tmux -S "$SOCKET" has-session -t "$SESSION" 2>/dev/null; then
  tmux -S "$SOCKET" new-session -d -s "$SESSION"
fi
while true; do
  if ! tmux -S "$SOCKET" has-session -t "$SESSION" 2>/dev/null; then
    tmux -S "$SOCKET" new-session -d -s "$SESSION"
  fi
  sleep 15
done
