#!/bin/bash
# Attach the browser exec to the one workshop session.
SOCKET=/var/tmux/workshop
SESSION=workshop
mkdir -p /var/tmux
chmod 700 /var/tmux
if ! tmux -S "$SOCKET" has-session -t "$SESSION" 2>/dev/null; then
  tmux -S "$SOCKET" new-session -d -s "$SESSION"
fi
exec tmux -S "$SOCKET" attach -d -t "$SESSION"
