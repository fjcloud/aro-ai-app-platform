{
  "checks": [
    {
      "panel": "Coding tokens by subscription",
      "query": "sum by (model, subscription) (authorized_hits{model=\"deepseekv4pro\",subscription=\"deepseekv4pro-workshop\"})",
      "series": 1,
      "samples": [
        {
          "labels": {
            "model": "deepseekv4pro",
            "subscription": "deepseekv4pro-workshop"
          },
          "value": "70"
        }
      ]
    },
    {
      "panel": "Coding requests accepted by quota checks",
      "query": "sum by (subscription) (authorized_calls{limitador_namespace=\"llm-serving/deepseekv4pro\",subscription=\"deepseekv4pro-workshop\"})",
      "series": 1,
      "samples": [
        {
          "labels": {
            "subscription": "deepseekv4pro-workshop"
          },
          "value": "2"
        }
      ]
    },
    {
      "panel": "Quota rejections (HTTP 429)",
      "query": "sum(limited_calls{limitador_namespace=\"llm-serving/deepseekv4pro\"}) or vector(0)",
      "series": 1,
      "samples": [
        {
          "labels": {},
          "value": "2"
        }
      ]
    },
    {
      "panel": "Whisper completed requests",
      "query": "sum(vllm:request_success_total{namespace=\"speech-serving\",finished_reason=\"stop\"})",
      "series": 1,
      "samples": [
        {
          "labels": {},
          "value": "3"
        }
      ]
    },
    {
      "panel": "Whisper inference latency p95",
      "query": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{namespace=\"speech-serving\"}[5m])))",
      "series": 1,
      "samples": [
        {
          "labels": {},
          "value": "0.28969695326900136"
        }
      ]
    },
    {
      "panel": "Whisper queued requests",
      "query": "sum(vllm:num_requests_waiting{namespace=\"speech-serving\"})",
      "series": 1,
      "samples": [
        {
          "labels": {},
          "value": "0"
        }
      ]
    },
    {
      "panel": "T4 utilization \u2014 speech only",
      "query": "DCGM_FI_DEV_GPU_UTIL{exported_namespace=\"speech-serving\"}",
      "series": 1,
      "samples": [
        {
          "labels": {
            "gpu": "0",
            "modelName": "Tesla T4",
            "namespace": "nvidia-gpu-operator"
          },
          "value": "0"
        }
      ]
    },
    {
      "panel": "T4 memory used (GiB)",
      "query": "DCGM_FI_DEV_FB_USED{exported_namespace=\"speech-serving\"} / 1024",
      "series": 1,
      "samples": [
        {
          "labels": {
            "gpu": "0",
            "modelName": "Tesla T4",
            "namespace": "nvidia-gpu-operator"
          },
          "value": "7.45703125"
        }
      ]
    },
    {
      "panel": "Scrape health \u2014 1 means reachable",
      "query": "min by (namespace) (up{namespace=~\"speech-serving|kuadrant-system\",job=~\"whisper-predictor|kuadrant-system/kuadrant-limitador-monitor\"})",
      "series": 2,
      "samples": [
        {
          "labels": {
            "namespace": "speech-serving"
          },
          "value": "1"
        },
        {
          "labels": {
            "namespace": "kuadrant-system"
          },
          "value": "1"
        }
      ]
    }
  ],
  "note": "Latency can be NaN when no requests completed in the last five minutes."
}
